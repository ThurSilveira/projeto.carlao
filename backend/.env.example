DATABASE_URL=postgresql://escala:escala@127.0.0.1:5432/escala_ministerial
DB_SSL=false
DB_SSLMODE=
# Alternativa à DATABASE_URL (útil para credenciais com caracteres especiais):
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=escala_ministerial
# DB_USERNAME=escala
# DB_PASSWORD=troque-localmente
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
PORT=8080
AUTH_ADMIN_NAME=Administrador
AUTH_ADMIN_EMAIL=admin@example.com
# Use uma frase-senha exclusiva com pelo menos 12 caracteres; nunca versione a senha real.
AUTH_ADMIN_PASSWORD=
AUTH_MINISTRO_NAME=Ministro de Teste
AUTH_MINISTRO_EMAIL=ministro@example.com
# O usuário de teste só é criado em desenvolvimento e quando esta senha for informada.
AUTH_MINISTRO_PASSWORD=
AUTH_SESSION_HOURS=8
EVENT_TIMEZONE=America/Sao_Paulo
EVENT_DURATION_MINUTES=120

# Google Calendar: OAuth da conta organizadora. Mantenha desativado até configurar tudo.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_EVENT_NAMESPACE=escala-ministerial-development
GOOGLE_CALENDAR_SAME_DAY_REMINDER_MINUTES=60
