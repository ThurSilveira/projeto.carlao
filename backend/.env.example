DATABASE_URL=postgresql://escala:escala@127.0.0.1:5432/escala_ministerial
DB_SSL=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
PORT=8080
AUTH_ADMIN_NAME=Administrador
AUTH_ADMIN_EMAIL=admin@example.com
# Use uma senha exclusiva com pelo menos 12 caracteres. Não versionar a senha real.
AUTH_ADMIN_PASSWORD=troque-esta-senha-antes-de-executar
AUTH_MINISTRO_NAME=Ministro de Teste
AUTH_MINISTRO_EMAIL=ministro@example.com
# Use uma senha exclusiva com pelo menos 12 caracteres. Não versionar a senha real.
AUTH_MINISTRO_PASSWORD=troque-esta-senha-antes-de-executar
AUTH_SESSION_HOURS=8

# Google Calendar: ative somente após fornecer credenciais OAuth da conta organizadora.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo
GOOGLE_CALENDAR_EVENT_DURATION_MINUTES=120
